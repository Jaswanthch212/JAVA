class Solution {
    public int uniqueXorTriplets(int[] nums) {
        int MAX = 2048;

        boolean[][] dp = new boolean[4][MAX];
        dp[0][0] = true;

        for (int v : nums) {
            boolean[][] ndp = new boolean[4][MAX];

            for (int i = 0; i < 4; i++)
                System.arraycopy(dp[i], 0, ndp[i], 0, MAX);

            for (int c = 0; c < 3; c++) {
                for (int x = 0; x < MAX; x++) {
                    if (!dp[c][x]) continue;

                    int y = x;
                    for (int t = 1; t <= 3 - c; t++) {
                        y ^= v;
                        ndp[c + t][y] = true;
                    }
                }
            }

            dp = ndp;
        }

        int ans = 0;
        for (boolean b : dp[3])
            if (b) ans++;

        return ans;
    }
}
