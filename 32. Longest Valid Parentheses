class Solution {
    public int longestValidParentheses(String s) {
        int open = 0;
        int close = 0;
        int ans = 0;

        // Left → Right
        for (char c : s.toCharArray()) {
            if (c == '(')
                open++;
            else
                close++;

            if (open == close)
                ans = Math.max(ans, 2 * close);

            if (close > open) {
                open = 0;
                close = 0;
            }
        }

        open = 0;
        close = 0;

        // Right → Left
        for (int i = s.length() - 1; i >= 0; i--) {
            if (s.charAt(i) == '(')
                open++;
            else
                close++;

            if (open == close)
                ans = Math.max(ans, 2 * open);

            if (open > close) {
                open = 0;
                close = 0;
            }
        }

        return ans;
    }
}
